# ============================================================================
# Stock MCP Service (:18081) — GraalVM Native 镜像（main/Dockerfile.native 同款模板）
# 构建假设：native 二进制已由 CI/本地编译好（stock-calculator-mcp/build-native.sh），
# 本 Dockerfile 只负责打包成最小运行镜像，不再在镜像内编译。
#
# glibc 兼容性：CI (ubuntu-latest = 24.04, glibc 2.39) 编出的二进制，
# 基座必须 >= 2.39，故用 ubuntu:24.04（与 main/data 同款）。
# ============================================================================
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libstdc++6 \
        zlib1g \
        curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r spring && useradd -r -g spring spring

COPY --chown=spring:spring --chmod=755 target/stock-mcp-service /application/stock-mcp-service

USER spring:spring

EXPOSE 18081

# 就绪探针（-f 必需）：orchestration 的 McpSyncClient 在 bean 创建期连 :18081 初始化，
# 端口监听成功但工具面未装配时依赖方仍会 initialize 超时炸启动，故必须探 /internal/ready
# （ApplicationContextReadyEvent 之后才 200；curl 不加 -f 时 404 也算成功，端口探活不可靠）。
HEALTHCHECK --start-period=15s --timeout=5s --interval=30s --retries=3 \
    CMD curl -fs -m 3 http://localhost:18081/internal/ready > /dev/null 2>&1 || exit 1

ENTRYPOINT ["/application/stock-mcp-service"]
