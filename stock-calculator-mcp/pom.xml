<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.zzh</groupId>
        <artifactId>stock-calculator-service</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>stock-calculator-mcp</artifactId>
    <name>stock-calculator-mcp</name>
    <description>本地 MCP 服务：股票指标计算（按需现算）+ 经典书籍知识检索（RAG），设计见 docs/mcp/design.md</description>
    <dependencies>
        <!-- MCP 服务端（Streamable HTTP），BOM 2.0.1 管版本；JVM 模式，不参与 native -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>
        <!-- kb_book / kb_chunk（stock_mcp 独立库） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- LLM chat tier 设施（ai.tiers.chat + LlmRegistry），依赖红线见模块描述 -->
        <dependency>
            <groupId>com.zzh</groupId>
            <artifactId>stock-calculator-llm</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- JPA native 静态反射/资源元数据（naming/Dialect/id 优化器/BytecodeProvider none/
             DTD 资源）：经 JpaRuntimeHints(RuntimeHintsRegistrar) + aot.factories 自动吸收，
             库自带 resource-config.json / native-image.properties 一并继承；详见
             docs/architecture/jpa-native-extraction.md P1/P2。仅元数据，无运行期类型依赖
             （spring-core optional 不传递）。 -->
        <dependency>
            <groupId>com.zzh</groupId>
            <artifactId>stock-calculator-jpa</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- 字典镜像读取（stock:dict，main crawler 域写入） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Jackson 3（Boot 4 线）：与 main 同坐标，字典 JSON 解析用 -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- 技术指标计算（D5 路线一：按需现算）；钉 0.17：0.18+ 字节码基线升至 Java 17/25，
             0.22.8 起实测 class v69 无法在 Java 21 工具链编译运行 -->
        <dependency>
            <groupId>org.ta4j</groupId>
            <artifactId>ta4j-core</artifactId>
            <version>0.17</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
