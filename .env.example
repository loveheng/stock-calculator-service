# ============ 连接拓扑（容器部署 = compose 服务名；本地宿主机跑应用时主机名改 localhost） ============
POSTGRES_URL=jdbc:postgresql://postgres:5432/scs
REDIS_HOST=redis
RABBIT_HOST=lavinmq
# app 管线巡检（PipelineWatchTask）的管理 API
RABBIT_MGMT_URL=http://lavinmq:15672

# Postgres 口令：postgres 初始化读 POSTGRES_PASSWORD，应用连接读 POSTGRES_PASS，
# 同一个值、两个都必须有（应用侧变量名是历史约定，CI 冒烟脚本同用 POSTGRES_PASS）；
# 仅首次初始化数据卷时生效
POSTGRES_PASS=<YOUR_POSTGRES_PASSWORD>

CRAWLER_ADMIN_TOKEN=<YOUR_CRAWLER_ADMIN_TOKEN>

AZURE_OCR_API_KEY=<YOUR_AZURE_OCR_API_KEY>

GROQ_API_KEY=<YOUR_GROQ_API_KEY>

OCRSPACE_API_KEY=<YOUR_OCRSPACE_API_KEY>

# 可选：宿主机端口（默认 18080）
#APP_PORT=18080
# 可选：应用镜像 tag
APP_IMAGE_TAG=417aabf
FRONTEND_IMAGE_TAG=sha-f9ac614
DATA_IMAGE_TAG=3a4f486

# 可选：附加 Spring Boot 启动参数（空格分隔，如 --crawler.enabled=false）
#APP_ARGS=
DEEPSEEK_MODEL=glm-5.3-flash
DEEPSEEK_BASE_URL=https://tokenrhythm.studio/v1
DEEPSEEK_API_KEY=<YOUR_DEEPSEEK_API_KEY>

# 邮件服务配置 (Sina SMTP)
SMTP_HOST=smtp.sina.com            # @sina.cn 账号则用 smtp.sina.cn
SMTP_PORT=465
SMTP_SSL=true
SMTP_STARTTLS=false
SMTP_USERNAME=2012qingnian@sina.com
SMTP_PASSWORD=<YOUR_SINA_SMTP_PASSWORD>   # 新浪邮箱授权码/密码
MAIL_FROM=2012qingnian@sina.com           # 新浪校验 From=认证账号，必须一致
EMBEDDING_NOTIFY_EMAIL=zhzheng.zhao@gmail.com # 向量化完成通知接收邮箱

# Cloudflare Workers AI 配置
CLOUDFLARE_ACCOUNT_ID=<YOUR_CLOUDFLARE_ACCOUNT_ID>
CLOUDFLARE_API_TOKEN=<YOUR_CLOUDFLARE_API_TOKEN>

# ============ data 数据服务（stock-calculator-data） ============
# LavinMQ 业务账号（默认 guest 仅限回环连接，容器网络连入必须用专用账号）。
# 由 compose 的 lavinmq-init 自动创建并授权（幂等，改口令后重新 compose up 即同步），
# 无需手动 lavinmqctl；口令避免空格和引号
RABBIT_USER=scs
RABBIT_PASS=<YOUR_RABBIT_PASSWORD>

# 可选：ingest webhook 宿主端口（默认 18081；不用 ingest 可在 compose 注释掉端口映射）
#DATA_PORT=18081
# 必填：公告蒸馏 LLM（OpenAI 兼容渠道，base-url 到 /chat/completions 的上级）。
# worker 角色在 CI 镜像内钉死开启，三个键任缺其一 data 容器拒绝启动。
# 现用 CF Workers AI 的 OpenAI 兼容端点（免费计划；glm-5.3-flash 等部分模型需付费计划）：
LLM_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
LLM_API_KEY=<CF Workers AI 令牌，cfut_ 开头>
LLM_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# 可选：ingest webhook 的 HMAC-SHA256 共享密钥（未配置时 ingest 端点拒绝所有请求）
#INGEST_SECRET=
