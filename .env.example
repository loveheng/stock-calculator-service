# ==============================================================================
# 服务环境配置文件模板 (.env.example)
# 使用说明：复制此文件为 .env，并填充具体的真实密钥与配置值
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 基础数据库与中间件配置 (Database & Middleware)
# ------------------------------------------------------------------------------
# Postgres 口令：postgres 初始化与应用共用（仅首次初始化数据卷时生效）
POSTGRES_PASS=zzh@scs.com
POSTGRES_URL=jdbc:postgresql://postgres:5432/scs
POSTGRES_URL_MCP=jdbc:postgresql://postgres:5432/stock_mcp

REDIS_HOST=redis
RABBIT_HOST=lavinmq

# app 管线巡检（PipelineWatchTask）的管理 API
RABBIT_MGMT_URL=http://lavinmq:15672

# LavinMQ 专用账号（默认 guest 仅限回环连接，容器网络连入必须用专用账号）。
# 先建账号再填这里：
#   docker compose exec lavinmq lavinmqctl add_user <USER> <PASS>
#   docker compose exec lavinmq lavinmqctl set_permissions <USER> '.*' '.*' '.*'
#   docker compose exec lavinmq lavinmqctl set_user_tags <USER> monitoring
# （monitoring tag 供 app 管线巡检查 /api/queues，缺了会 403）
RABBIT_USER=scs
RABBIT_PASS=zzh@scs.com

# ------------------------------------------------------------------------------
# 2. 镜像版本与服务端口 (Docker Images & Ports)
# ------------------------------------------------------------------------------
# 可选：宿主机端口（默认 18080）
#APP_PORT=18080

# 可选：ingest webhook 宿主端口（默认 18081；不用 ingest 可在 compose 注释掉端口映射）
DATA_PORT=28081

# 应用镜像 Tag
APP_IMAGE_TAG=439d288
DATA_IMAGE_TAG=439d288
MCP_IMAGE_TAG=439d288
NOTIFY_IMAGE_TAG=439d288
ORCHESTRATION_IMAGE_TAG=439d288

# 可选：附加 Spring Boot 启动参数（空格分隔，如 --crawler.enabled=false）
#APP_ARGS=

# ------------------------------------------------------------------------------
# 3. 系统安全与管理令牌 (Security & Management Tokens)
# ------------------------------------------------------------------------------
CRAWLER_ADMIN_TOKEN=your_crawler_admin_token_here

# 可选：ingest webhook 的 HMAC-SHA256 共享密钥（未配置时 ingest 端点拒绝所有请求）
#INGEST_SECRET=your_ingest_secret_here

# ------------------------------------------------------------------------------
# 4. LLM & 大模型 AI 服务配置 (LLM & AI Services)
#    OPENAI_MAX 强推理 OPENAI_CHAT 聊天 OPENAI_MINI 文本摘要
# ------------------------------------------------------------------------------
# DeepSeek / 大模型基础配置 / data服务pdf结构的拆分和内容重要性判定
# DEEPSEEK_MODEL=XingChenAGI/Xing4.0-29B
# DEEPSEEK_BASE_URL=https://api.siliconflow.cn/v1
# DEEPSEEK_API_KEY=sk-isvzuvgupgifgtyqjvesagnvakkriynjislkcslcrhhimwhr
#

OPENAI_MAX_BASE_URL=YOUR_OPENAI_MAX_API_KEY
OPENAI_MAX_API_KEY=YOUR_OPENAI_MAX_API_KEY
OPENAI_MAX_MODEL=YOUR_OPENAI_MAX_MODEL

OPENAI_CHAT_BASE_URL=YOUR_OPENAI_CHAT_BASE_URL
OPENAI_CHAT_API_KEY=YOUR_OPENAI_CHAT_API_KEY
OPENAI_CHAT_MODEL=YOUR_OPENAI_CHAT_MODEL

OPENAI_MINI_BASE_URL=YOUR_OPENAI_MINI_BASE_URL
OPENAI_MINI_API_KEY=YOUR_OPENAI_MINI_API_KEY
OPENAI_MINI_MODEL=YOUR_OPENAI_MINI_MODEL


# GROQ API 配置
GROQ_API_KEY=YOUR_groq_api_key_here


# GEMINI_API_KEY 配置
GEMINI_API_KEY=AQ.your_GEMINI_API_KEY

# GROQ API 配置
GROQ_API_KEY=YOUR_GROQ_API_KEY

# ------------------------------------------------------------------------------
# 5. OCR 文字识别服务 (OCR Services)
# ------------------------------------------------------------------------------
AZURE_OCR_API_KEY=YOUR_AZURE_OCR_API_KEY
OCRSPACE_API_KEY=YOUR_OCRSPACE_API_KEY

# ------------------------------------------------------------------------------
# 6. Cloudflare 云服务配置 (Cloudflare) 主服务的向量化
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_API_TOKEN

# ------------------------------------------------------------------------------
# 7. 邮件服务配置 (SMTP & Mail Notifications)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.sina.com
# @sina.cn 账号则用 smtp.sina.cn
SMTP_PORT=465
SMTP_SSL=true
SMTP_STARTTLS=false
SMTP_USERNAME=YOUR_SMTP_USERNAME@sina.com
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
MAIL_FROM=YOUR_SMTP_USERNAME@sina.com
# 新浪同样校验 From=认证账号，必须一致

# 接收向量/嵌入通知的邮箱地址
EMBEDDING_NOTIFY_EMAIL=YOUR_SEMBEDDING_NOTIFY_EMAIL@outlook.com

# ------------------------------------------------------------------------------
# 8. data采集开关
# ------------------------------------------------------------------------------
WORKER_ENABLE=true
COLLECT_ENABLE=true

# ------------------------------------------------------------------------------
# 8. data采集开关
# ------------------------------------------------------------------------------
MCP_BROKER_URL=http://localhost:18081/sse
