# ============================================================================
# Stock Calculator Service — 环境变量配置示例
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env
# ============================================================================

# Google Gemini API Key（必填）
# Spring AI 使用此密钥调用 Gemini 多模态模型进行图像识别
# 申请地址：https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# 图像预处理服务地址（可选，默认 http://localhost:8088）
# 指向 imgproxy 或 imaginary 等外部图像处理服务
IMAGE_SERVICE_URL=http://localhost:8088