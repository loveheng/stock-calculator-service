# ============================================================================
# Stock Calculator Service — 环境变量配置示例
# 复制此文件为 .env 并填入实际值：
#   cp .env.example .env
# ============================================================================

# Google Gemini API Key（必填）
# 调用 Gemini 多模态模型进行图像识别（main 走 Spring AI，native 走 gemini.* 配置）
# 申请地址：https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# PostgreSQL 口令（必填；docker compose 与应用运行时共用）
# 注意：仅首次初始化 postgres 数据卷时生效；既有数据卷需保持原值或重建卷
POSTGRES_PASSWORD=change-me

# 应用连接数据库时的口令（与 POSTGRES_PASSWORD 保持一致）
POSTGRES_PASS=change-me

# 财联社历史数据管理端点令牌（可选；未配置时 /api/admin/sync 拒绝所有请求）
CRAWLER_ADMIN_TOKEN=change-me
