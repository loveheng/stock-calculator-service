<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.zzh</groupId>
    <artifactId>stock-calculator-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>stock-calculator</name>

    <properties>
        <java.version>21</java.version>
    </properties>


    <dependencies>

        <!-- Spring Boot 4.x WebMVC Starter（官方推荐，非 deprecated）
             包含 spring-boot-starter-jackson / Jackson 3 (tools.jackson)、Tomcat、Spring MVC。
             Jackson 3 由 spring-boot-starter-jackson 传递引入，无需显式声明。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Spring Cache 抽象 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- 高性能本地缓存 Caffeine (版本由 Boot Parent 自动管理) -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试组件 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>


    <build>
        <plugins>
            <!-- Spring Boot 打包插件 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- 显式配置编译插件与 Lombok 注解处理器（避免 Java 21 下偶发编译警告/反射异常） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- 原生镜像编译 Profile (需要 Native 时激活: mvn -Pnative package) -->
    <profiles>
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <!-- 1. 在 process-classes 阶段触发 AOT 处理（compile 之后），生成 Hint 元数据与 AOT 初始化器源码 -->
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>process-aot</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>process-aot</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- 1.5 AOT 源码编译：在 process-aot 生成源码后，重新编译包括 AOT 初始化器在内的所有源码 -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>compile-after-aot</id>
                                <phase>process-classes</phase>
                                <goals>
                                    <goal>compile</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 2. GraalVM Native 编译插件 -->
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>stock-calculator-service</imageName>
                            <mainClass>com.zzh.stock_calculator.StockCalculatorApplication</mainClass>
                            <buildArgs>
                                <!-- 限制 Native-image 编译器最大占用 7GB 内存，与系统 30GB / 12核 匹配，避免瞬时峰值 OOM -->
                                <buildArg>-J-Xmx7g</buildArg>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                                <buildArg>-H:+AddAllCharsets</buildArg>
                                <buildArg>-H:EnableURLProtocols=https</buildArg>
                                <!-- Jackson 3 (tools.jackson) 由 Spring Boot 4 提供完整的 AOT Hint 支持，无需手动指定运行时初始化 -->
                                <buildArg>--enable-all-security-services</buildArg>
                                <buildArg>-H:+ReportUnsupportedElementsAtRuntime</buildArg>
                                <!-- 安装退出信号处理器，Docker 环境下优雅关闭 -->
                                <buildArg>--install-exit-handlers</buildArg>
                                <!-- Logback/SLF4J 由 Spring AOT PreComputeFieldFeature 在构建时初始化，
                                     因此显式标记为 build-time 初始化，避免与 reachability-metadata 的运行时要求冲突。 -->
                                <buildArg>--initialize-at-build-time=ch.qos.logback.classic,ch.qos.logback.core,org.slf4j</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
