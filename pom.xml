<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.zzh</groupId>
    <artifactId>stock-calculator-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>stock-calculator</name>

    <properties>
        <java.version>21</java.version>
        <spring-ai.version>2.0.1</spring-ai.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring AI BOM 版本管理 -->
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>


    <dependencies>

        <!-- Spring Boot 4.x 标准 WebMVC Starter（包含 spring-boot-starter-json / Jackson 3） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- 显式引入 Jackson 2（com.fasterxml.jackson），因为 Spring Boot 4.x 默认使用 Jackson 3（tools.jackson）
             代码中的 DTO、枚举、ObjectMapper 均基于 Jackson 2 类型 -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Spring AI OpenAI Starter（2.0.x 命名规范：spring-ai-starter-model-{provider}） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- Spring Cache 抽象 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- 高性能本地缓存 Caffeine (版本由 Boot Parent 自动管理) -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 测试组件 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>


    <build>
        <plugins>
            <!-- Spring Boot 打包插件 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- 显式配置编译插件与 Lombok 注解处理器（避免 Java 21 下偶发编译警告/反射异常） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <!-- 原生镜像编译 Profile (需要 Native 时激活: mvn -Pnative package) -->
    <profiles>
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <!-- 1. 必须在编译前触发 AOT 处理生成 Hint 元数据 -->
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>process-aot</id>
                                <goals>
                                    <goal>process-aot</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- 2. GraalVM Native 编译插件 -->
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <extensions>true</extensions>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals>
                                    <goal>compile-no-fork</goal>
                                </goals>
                                <phase>package</phase>
                            </execution>
                        </executions>
                        <configuration>
                            <imageName>stock-calculator-service</imageName>
                            <mainClass>com.zzh.stock_calculator.StockCalculatorApplication</mainClass>
                            <buildArgs>
                                <!-- 限制 Native-image 编译器最大占用 5GB 内存，避免爆内存 -->
                                <buildArg>-J-Xmx5g</buildArg>
                                <buildArg>--no-fallback</buildArg>
                                <buildArg>-H:+ReportExceptionStackTraces</buildArg>
                                <buildArg>-H:+AddAllCharsets</buildArg>
                                <buildArg>-H:EnableURLProtocols=https</buildArg>
                                <buildArg>--enable-all-security-services</buildArg>
                                <!-- 运行时遇到不支持的 API 报错而非静默失败（GraalVM 21+ 已重命名为此选项） -->
                                <buildArg>-H:+ReportUnsupportedElementsAtRuntime</buildArg>
                                <!-- 安装退出信号处理器，Docker 环境下优雅关闭 -->
                                <buildArg>--install-exit-handlers</buildArg>
                                <!-- Jackson 2 需要在运行时初始化（而非构建时），否则 ObjectMapper 内部缓存会出错 -->
                                <buildArg>--initialize-at-run-time=com.fasterxml.jackson.databind.ObjectMapper,com.fasterxml.jackson.databind.json.JsonMapper,com.fasterxml.jackson.databind.ObjectReader,com.fasterxml.jackson.databind.ObjectWriter</buildArg>
                            </buildArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>