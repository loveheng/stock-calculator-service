<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.zzh</groupId>
        <artifactId>stock-calculator-service</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>stock-calculator-orchestration</artifactId>
    <name>stock-calculator-orchestration</name>
    <description>Agent 任务编排服务 :18083：MCP task 工具面（create_task/query_task）+ Planner 规划器 + Executor 确定性 DAG 执行，三表落 stock_mcp 库，设计见 docs/architecture/agent-orchestration.md</description>
    <dependencies>
        <!-- MQ 契约：MessageEnvelope/MqKey 常量与消息 DTO（mq_send/mq_wait 节点与 traceId 贯穿，D6 自引） -->
        <dependency>
            <groupId>com.zzh</groupId>
            <artifactId>stock-calculator-contract</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- LLM chat tier 设施（ai.tiers.planner + LlmRegistry），依赖红线见模块描述 -->
        <dependency>
            <groupId>com.zzh</groupId>
            <artifactId>stock-calculator-llm</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Boot 4 webmvc 标准装配（含 spring-boot-restclient → RestClient.Builder，ToolInvoker rest 节点依赖；
             spring-ai mcp server-webmvc 传递的 spring-boot-starter-web 不含 restclient 模块，缺它服务起不来） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- RestClient.Builder 自动装配（RestClientAutoConfiguration，Boot 4 拆模块后独立 starter）：
             ToolInvoker/PlannerLlmClient/IntentEmbeddingClient 构造注入依赖（mcp 模块靠 openai starter 传递拿到，本模块无 model starter 需显式声明） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <!-- MCP 服务端（Streamable HTTP）：task 工具面 :18083/sse，copilot 经 MCP client 调用 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>
        <!-- MCP 客户端（Streamable HTTP）：Executor kind=mcp 节点调 :18081 工具（D5 统一工具面） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>
        <!-- MQ：mq_send 下发任务消息 / mq_wait 事件唤醒（与 notify 同款独立 amqp 依赖） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <!-- 三表（tool_registry/plan/task_instance，stock_mcp 库，D6） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- JPA native 静态反射/资源元数据（naming/Dialect/id 优化器/BytecodeProvider none/
             DTD 资源）：经 JpaRuntimeHints(RuntimeHintsRegistrar) + aot.factories 自动吸收，
             库自带 resource-config.json / native-image.properties 一并继承；详见
             docs/architecture/jpa-native-extraction.md P1/P2。仅元数据，无运行期类型依赖
             （spring-core optional 不传递）。 -->
        <dependency>
            <groupId>com.zzh</groupId>
            <artifactId>stock-calculator-jpa</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Jackson 3（Boot 4 线）：DAG/信封/payload 序列化 -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
