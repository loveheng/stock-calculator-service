<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.zzh</groupId>
        <artifactId>stock-calculator-service</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>stock-calculator-main</artifactId>
    <name>stock-calculator-main</name>
    <dependencies>
        <!-- E2EE 用户服务：仅取 BCrypt 实现，不引入 Security 过滤链（《设计》§D.5.1） -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <!-- E2EE 用户服务：找回验证码邮件（《设计》§D.5.2） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <!-- E2EE 用户服务缓存层（决策 B11）：会话热读缓存 + 限流计数；仅 main 变体引入，native 不受影响 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- 数据服务拆分阶段 1（docs/architecture/data-service-split.md）：result 上行消费 + 后续任务发布 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <!-- 消息契约（队列常量 + 统一信封 + DTO，纯 POJO） -->
        <dependency>
            <groupId>com.zzh</groupId>
            <artifactId>stock-calculator-contract</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Jackson 3（Boot 4 默认）：vision 的 JSON 反序列化；
             注解包 com.fasterxml.jackson.annotation 与 2.x 同名，两代兼容 -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <!-- Web Push（RFC 8291 加密 + VAPID 签名）：PWA 推送触达（iOS 16.4+/Android Chrome 标准 Web Push） -->
        <dependency>
            <groupId>nl.martijndwars</groupId>
            <artifactId>web-push</artifactId>
            <version>5.1.2</version>
        </dependency>
        <!-- web-push 的 ECC 加密（RFC 8291 aes128gcm）依赖 BouncyCastle -->
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>1.78.1</version>
        </dependency>
        <!-- web-push 5.1.x 的 send() 签名引用 HttpClient 4.x（非传递依赖，需显式引入） -->
        <dependency>
            <groupId>org.apache.httpcomponents</groupId>
            <artifactId>httpclient</artifactId>
            <version>4.5.14</version>
        </dependency>
        <!-- web-push 5.1.x 的 VAPID 签名用 jose4j（库 POM 未声明，需显式引入） -->
        <dependency>
            <groupId>org.bitbucket.b_c</groupId>
            <artifactId>jose4j</artifactId>
            <version>0.9.6</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <!-- MCP client：连 :18081 stock-mcp 经纪人 + :18082 stock-mcp-notify 提醒工具面
             （docs/notify/design.md §七：reminder_* 四工具与经纪人工具同池注册给 LLM）；
             2.0.x 无 -webmvc 变体，streamable-http 传输由本 starter 内含（m2 实证） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-client</artifactId>
        </dependency>
        <!-- 向量存储（方案一）：Spring AI 官方 PgVectorStore，BOM 2.0.1 管版本；
             见 docs/ai-pipeline/cls-article-vector.md D2 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-pgvector</artifactId>
        </dependency>
        <dependency>
            <!-- spring-ai 将 reactor 标为 optional（阻塞用法不强制），Copilot 流式（chatModel.stream 返回 Flux）需显式引入；版本由 Boot BOM 管理 -->
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>
    <build>
        <resources>
            <!-- 一旦声明 resources 即覆盖 Maven 默认映射，默认目录必须显式保留 -->
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- postgres/schema.sql + data.sql → classpath 根（Boot 默认脚本位置）：
                 配合 spring.sql.init.mode=always，应用每次启动自动建表+播种（脚本幂等）；
                 native 资源由 Boot 内置 SqlInitializationScriptsRuntimeHints
                 （schema.sql/schema-*.sql/data.sql/data-*.sql 四个模式）自动注册，
                 无需手动 hints。文件本体仍以 postgres/ 目录为事实源（README/设计文档引用） -->
            <resource>
                <directory>../postgres</directory>
                <includes>
                    <include>schema.sql</include>
                    <include>data.sql</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- build-native.sh / CI 通过 -Pnative 激活：绑定 AOT 处理，为 native-image 生成 spring-aot 产物 -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>process-aot</id>
                                <goals>
                                    <goal>process-aot</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>