<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.zzh</groupId>
        <artifactId>stock-calculator-service</artifactId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <artifactId>stock-calculator-mcp-notify</artifactId>
    <name>stock-calculator-mcp-notify</name>
    <description>个人定制提醒服务：提醒登记（MCP 工具面）+ 触发引擎（TTL+DLX 自循环）+ 推送投递，设计见 docs/notify/design.md</description>
    <dependencies>
        <!-- MQ 契约：队列/routing key 常量与消息 DTO（与 main/data 同源） -->
        <dependency>
            <groupId>com.zzh</groupId>
            <artifactId>stock-calculator-contract</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- MCP 服务端（Streamable HTTP）：工具面 :18082/sse，LLM 对话内操作提醒（N4） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>
        <!-- MQ：消费事件/fire 队列、发推送与能力请求（N1 硬依赖，独立于 stock-mcp 的原因） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <!-- reminder 表（stock_mcp 库，N3） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- JPA native 静态反射/资源元数据（naming/Dialect/id 优化器/BytecodeProvider none/
             DTD 资源）：经 JpaRuntimeHints(RuntimeHintsRegistrar) + aot.factories 自动吸收，
             库自带 resource-config.json / native-image.properties 一并继承；详见
             docs/architecture/jpa-native-extraction.md P1/P2。仅元数据，无运行期类型依赖
             （spring-core optional 不传递）。 -->
        <dependency>
            <groupId>com.zzh</groupId>
            <artifactId>stock-calculator-jpa</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!-- Jackson 3（Boot 4 线）：信封/payload 序列化 -->
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
